# Copy to .env for local development. Never commit .env.

# Local PostgreSQL 17 (installed on your PC, or `npm run db:up` with Docker).
# The app uses DATABASE_URL at runtime.
DATABASE_URL="postgresql://unzanac:unzanac_dev@localhost:5432/unzanac?schema=public"

# Migrations use DIRECT_URL when set, otherwise DATABASE_URL. Leave unset locally.
# On Neon (staging/production):
#   DATABASE_URL = the POOLED connection string (host contains "-pooler"), with ?sslmode=require
#   DIRECT_URL   = the DIRECT connection string (no "-pooler"), with ?sslmode=require
# DIRECT_URL=""

# Public site URL, used for absolute links (share text, .ics, sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Better Auth. Generate a long random secret per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
