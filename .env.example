# Copy to .env for local development. Never commit .env.

# Local PostgreSQL 17 (installed on your PC, or `npm run db:up` with Docker).
# The app uses DATABASE_URL at runtime.
DATABASE_URL="postgresql://unzanac:unzanac_dev@localhost:5432/unzanac?schema=public"

# Migrations use DIRECT_URL when set, otherwise DATABASE_URL. Leave unset locally.
# On Neon (staging/production):
#   DATABASE_URL = the POOLED connection string (host contains "-pooler"), with ?sslmode=require
#   DIRECT_URL   = the DIRECT connection string (no "-pooler"), with ?sslmode=require
# DIRECT_URL=""

# Public site URL, used for absolute links (share text, .ics, sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Better Auth. Generate a long random secret per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Daily jobs (/api/cron/daily). Vercel Cron sends "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# File storage for Resources (src/server/storage). Leave unset locally: files go to .storage/.
# Staging and production use Cloudflare R2 (a private bucket per environment). The bucket's CORS
# rules must allow PUT from the site's origin, because browsers upload straight to R2.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
