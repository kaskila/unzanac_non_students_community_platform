// UNZANAC platform schema. Full target model: docs/PLAN.md §7.
// Models are added milestone by milestone; M0 starts with committees.
// Convention: every DateTime is stored as timestamptz (UTC) and shown in Africa/Lusaka.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Committee {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  meetingInfo  String?
  contactName  String?
  contactPhone String? // E.164
  sortOrder    Int      @default(0)
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}

// ── Admin access (M1) ──

enum AdminInvitePurpose {
  INVITE // new admin account
  RESET // replace password and re-enrol 2FA for an existing admin
}

model AdminInvite {
  id          String             @id @default(cuid())
  tokenHash   String             @unique // sha256 of the token in the link; the token itself is never stored
  purpose     AdminInvitePurpose @default(INVITE)
  email       String
  name        String?
  role        String // owner | register_officer | editor
  userId      String? // set for RESET
  createdById String?
  expiresAt   DateTime           @db.Timestamptz(3)
  usedAt      DateTime?          @db.Timestamptz(3)
  revokedAt   DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)

  @@index([email])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // null = public visitor or system
  action     String // "admin.invite", "auth.sign_in", ...
  entityType String
  entityId   String?
  meta       Json?
  ipHash     String?
  at         DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([at])
}

// ── Better Auth tables (generated by `npx auth generate`; keep the @db.Timestamptz convention when regenerating) ──

model User {
  id               String      @id
  name             String
  email            String
  emailVerified    Boolean     @default(false)
  image            String?
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)
  twoFactorEnabled Boolean?    @default(false)
  role             String?
  banned           Boolean?    @default(false)
  banReason        String?
  banExpires       DateTime?   @db.Timestamptz(3)
  sessions         Session[]
  accounts         Account[]
  twofactors       TwoFactor[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime @db.Timestamptz(3)
  token          String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}
